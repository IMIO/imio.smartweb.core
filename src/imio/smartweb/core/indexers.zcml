<configure
    xmlns="http://namespaces.zope.org/zope">

  <adapter
      name="exclude_from_parent_listing"
      factory=".indexers.exclude_from_parent_listing"
      />

  <adapter
      name="SearchableText"
      factory=".indexers.SearchableText_section"
      />

  <adapter
      name="SearchableText"
      factory=".indexers.SearchableText_sectiontext"
      />

  <adapter
      name="SearchableText"
      factory=".indexers.SearchableText_sectionpostit"
      />

  <adapter
      name="SearchableText"
      factory=".indexers.SearchableText_sectiontimestampedpublications"
      />

  <adapter
      name="latitude"
      factory=".indexers.latitude_pages"
      />

  <adapter
      name="longitude"
      factory=".indexers.longitude_pages"
      />

  <adapter
      name="SearchableText"
      factory=".indexers.SearchableText_pages"
      />

  <adapter
      name="related_quickaccess"
      factory=".indexers.related_quickaccess"
      />

  <adapter
      name="category_and_topics"
      factory=".indexers.concat_category_topics_indexer"
      />

  <!-- Unconfigure default indexable object wrapper and define ours, which adds
       the labels of taxonomy terms to SearchableText -->
  <unconfigure package="Products.CMFPlone">
    <adapter
        factory="plone.indexer.wrapper.IndexableObjectWrapper"
        provides="plone.indexer.interfaces.IIndexableObject"
        for="Products.CMFCore.interfaces.ICatalogAware
             plone.base.interfaces.IPloneCatalogTool"
        />
  </unconfigure>

  <adapter
      factory=".indexers.SmartwebIndexableObjectWrapper"
      provides="plone.indexer.interfaces.IIndexableObject"
      for="Products.CMFCore.interfaces.ICatalogAware
           plone.base.interfaces.IPloneCatalogTool"
      />


</configure>
