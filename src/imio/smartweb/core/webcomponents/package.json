{
    "name": "imio.smartweb.core-webcomponents",
    "version": "0.0.1",
    "description": "Various React components exported as web components to use directly in template (.pt) files",
    "private": true,
    "scripts": {
        "build": "vite build --mode production",
        "build-dev": "vite build --mode development",
        "watch": "vite",
        "prettier": "prettier --check 'src/**/*.{js,jsx,ts,tsx,json}'",
        "prettier:fix": "prettier --write 'src/**/*.{js,jsx,ts,tsx,json}'",
        "lint": "eslint --max-warnings=0 'src/**/*.{js,jsx,json}'",
        "lint:fix": "eslint --fix 'src/**/*.{js,jsx,json}'"
    },
    "author": "iMio",
    "license": "GPLv2",
    "browserslist": [
        "> 0.10%",
        "not dead"
    ],
    "devDependencies": {
        "@vitejs/plugin-react": "^4.3.4",
        "autoprefixer": "^10.4.19",
        "core-js": "^3.36.1",
        "eslint": "^8.57.0",
        "eslint-plugin-import": "^2.29.1",
        "eslint-plugin-react": "^7.34.1",
        "postcss": "^8.4.38",
        "prettier": "3.2.5",
        "sass": "^1.83.4",
        "vite": "^6.0.0"
    },
    "dependencies": {
        "@babel/polyfill": "^7.12.1",
        "@loadable/component": "^5.16.3",
        "axios": "^1.6.8",
        "babel-polyfill": "^6.26.0",
        "bootstrap-icons": "^1.11.3",
        "date-fns": "^3.6.0",
        "flexbin": "^0.2.0",
        "leaflet": "^1.9.4",
        "lodash": "^4.17.21",
        "moment": "^2.30.1",
        "moment-timezone": "^0.6.1",
        "query-string": "^9.0.0",
        "react": "^18.2.0",
        "react-bootstrap": "^2.10.2",
        "react-content-loader": "^7.0.0",
        "react-datepicker": "^6.6.0",
        "react-dom": "^18.2.0",
        "react-highlight-words": "^0.20.0",
        "react-leaflet": "^4.2.1",
        "react-markdown": "^9.0.1",
        "react-router-dom": "^6.22.3",
        "react-select": "^5.10.1",
        "react-translated": "^2.5.0",
