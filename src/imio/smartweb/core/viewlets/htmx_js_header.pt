<tal:cond condition="python:not view.is_anonymous">
  <script src="https://unpkg.com/htmx.org@1.9.10/dist/htmx.js"></script>
  <script type="text/javascript">
/**
  Inline title edition (see @@inline_title / @@savetitle)
  contenteditable holds no form value, so feed the request from its text.
*/
document.addEventListener("htmx:configRequest", function(event) {
    var el = event.detail.elt;
    if (!el.classList || !el.classList.contains("inline-title")) return;
    event.detail.parameters.newTitle = el.innerText.trim();
    event.detail.parameters._authenticator = el.dataset.token;
});
document.addEventListener("keydown", function(event) {
    // Enter validates instead of inserting a line break
    if (event.key === "Enter" && event.target.classList.contains("inline-title")) {
        event.preventDefault();
        event.target.blur();
    }
});
/**
  Lock the object (plone.locking) as soon as inline edition of its title
  starts, so a second editor is blocked (@@savetitle checks can_edit_content)
  and sees the standard "Locked by X" banner, instead of only locking when
  the classic @@edit form happens to be open elsewhere. "focusin" bubbles
  (unlike the raw "focus" event), so a single delegated listener is enough.
  Fire-and-forget: @@plone_lock_operations is CSRF-exempt (plone.protect
  safe_views) and create_lock() is a no-op if already locked by this user.
*/
document.addEventListener("focusin", function(event) {
    var el = event.target;
    if (!el.classList || !el.classList.contains("inline-title")) return;
    if (!el.dataset.lockUrl) return;
    fetch(el.dataset.lockUrl + "?redirect:boolean=false", {
        method: "POST",
        credentials: "same-origin",
    });
});

document.addEventListener("DOMContentLoaded", function() {
    /**
      Manage section size
      When changing the select, update the class of the parent element to resize the section
    */
    document.querySelectorAll(".edit-section-container form.edit-section-size").forEach(function(form) {
        form.addEventListener("htmx:afterRequest", function(event) {
            var response = JSON.parse(event.detail.xhr.response);
            if (!response.id) return;
            var parent = form.closest('.sortable-section');
            var lst_parent_classes = parent.className.split(" ");
            var new_parent_classes = "";
            var find = false;
            for (var i = 0; i < lst_parent_classes.length; i++) {
                if (lst_parent_classes[i].startsWith("col-")) {
                    find = true;
                    lst_parent_classes[i] = response.id;
                }
                new_parent_classes += " " + lst_parent_classes[i];
            }
            // "col-" can not be found if there is no section size defined
            if (!find) {
                new_parent_classes += " " + response.id;
            }
            parent.className = new_parent_classes.trim();
            if (window.updateTextAlignmentLayout) window.updateTextAlignmentLayout();
        });
    });

    /**
      Manage section alignment
      When changing the select, toggle the "container-se-text" class on the parent
      element (response.id is the vocabulary token "main"/"text", not a CSS class).
      Also restrict the sibling section-size select to full/half width only
      when aligned with the text sections container, and reflect a
      server-forced size change (response.size_id) without reloading the page.
      The size <select> always contains all width options in the markup
      (rendered server-side) — only their hidden/disabled state changes here,
      so switching back to "main" alignment can always restore them.
    */
    var allowedTextSizes = ["col-sm-12", "col-sm-6"];

    function applyWidthConstraint(container, isTextAligned) {
        var sizeSelect = container ? container.querySelector("form.edit-section-size select") : null;
        if (!sizeSelect) return;
        Array.from(sizeSelect.options).forEach(function(option) {
            if (!option.value) return; // garde l'option vide "Width"
            var allowed = !isTextAligned || allowedTextSizes.indexOf(option.value) !== -1;
            option.hidden = !allowed;
            option.disabled = !allowed;
        });
    }

    document.querySelectorAll(".edit-section-container form.edit-section-alignment").forEach(function(form) {
        var container = form.closest(".edit-section-container");
        var alignmentSelect = form.querySelector("select");

        // Apply the constraint once on page load, matching the section's
        // current alignment.
        applyWidthConstraint(container, alignmentSelect && alignmentSelect.value === "text");

        form.addEventListener("htmx:afterRequest", function(event) {
            var response = JSON.parse(event.detail.xhr.response);
            if (!response.id) return;
            var parent = form.closest('.sortable-section');
            var lst_parent_classes = parent.className.split(" ").filter(function(klass) {
                return klass !== "container-se-text";
            });
            if (response.id === "text") {
                lst_parent_classes.push("container-se-text");
            }

            applyWidthConstraint(container, response.id === "text");
            if (response.size_id) {
                var sizeSelect = container ? container.querySelector("form.edit-section-size select") : null;
                if (sizeSelect) sizeSelect.value = response.size_id;
                lst_parent_classes = lst_parent_classes.filter(function(klass) {
                    return !klass.startsWith("col-");
                });
                lst_parent_classes.push(response.size_id);
            }

            parent.className = lst_parent_classes.join(" ").trim();
            if (window.updateTextAlignmentLayout) window.updateTextAlignmentLayout();
        });
    });
});
  </script>
</tal:cond>
