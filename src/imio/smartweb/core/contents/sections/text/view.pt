<html xmlns="http://www.w3.org/1999/xhtml" xml:lang="en"
      xmlns:tal="http://xml.zope.org/namespaces/tal"
      xmlns:metal="http://xml.zope.org/namespaces/metal"
      xmlns:i18n="http://xml.zope.org/namespaces/i18n"
      lang="en"
      metal:use-macro="context/@@main_template/macros/master"
      i18n:domain="plone">
<body>

<metal:main fill-slot="content-core">
<metal:content-core define-macro="content-core">
  <script tal:condition="view/can_edit | nothing">
      // one delegated hook for the whole page, whatever the number of sections.
      // The editor is always mounted (like .inline-title) - there is no
      // click-to-enter-edit-mode step, so that clicking the text is a native
      // browser click on the real contenteditable element: the cursor lands
      // exactly on the clicked character, for free.
      if (!window.smartwebInlineTextEditInit) {
        window.smartwebInlineTextEditInit = true;

        // TinyMCE loads asynchronously: until it creates its editable <div>,
        // the raw textarea would show its literal HTML source as plain text,
        // so we keep showing the server-rendered display div and reveal the
        // editor only once TinyMCE actually took over.
        (function waitForTinymce() {
          if (window.tinymce) {
            tinymce.on("AddEditor", function (e) {
              var el = e.editor.getElement();
              if (!el || el.id.indexOf("editableText_") !== 0) {
                return;
              }
              var uid = el.id.replace(/^editableText_/, "").replace(/-editable$/, "");
              var display = document.getElementById("displayText_" + uid);
              var form = el.closest("form.inline-text-edit");
              if (display) {
                display.style.display = "none";
              }
              if (form) {
                form.style.display = "";
              }
              el.classList.add("text");
              // Auto-save on blur: use TinyMCE's own "blur" event (fires only
              // once focus really leaves the whole editor, dialogs included)
              // rather than the raw DOM blur event, which would also fire -
              // and prematurely save - when a TinyMCE dialog (e.g. the link
              // dialog) opens.
              e.editor.on("blur", function () {
                var textarea = document.getElementById("editableText_" + uid);
                if (textarea) {
                  textarea.value = e.editor.getContent();
                }
                if (form) {
                  htmx.trigger(form, "save-text");
                }
              });
            });
          } else {
            setTimeout(waitForTinymce, 200);
          }
        })();
      }
  </script>
  <metal:macro use-macro="context/@@sections_macros/section_edition" />
  <div tal:define="image context/image | nothing;
                  collapse_klass_container python: 'section-text-collapsed' if context.collapsible_section else '';"
       id=""
       tal:attributes="class string:container section-container section-text ${collapse_klass_container};
                       id string:container-section-${context/id};">
    <metal:macro use-macro="context/@@sections_macros/section_title" />
    <div tal:define="collapse_klass python: 'collapse' if context.collapsible_section else '';
                     klass string:body-section figure-${context/alignment} figure-${context/image_scale} ${collapse_klass};"
         tal:attributes="class python:'{} {}'.format(klass, 'no-image') if not image else klass;
                         id string:body-section-${context/id}">
      <tal:cond condition="image">
        <figure>
          <img tal:attributes="src python:view.get_scale_url(context); alt python:context.image_caption if context.image_caption else ''" />
          <figcaption tal:condition="context/image_caption" tal:content="context/image_caption"></figcaption>
        </figure>
      </tal:cond>
      <div class="text"
           tal:define="can_edit view/can_edit | nothing"
           tal:attributes="id string:displayText_${context/UID};
                           class python: 'text text-editable' if can_edit else 'text'"
           tal:content="structure context/text/output | nothing"
           />
      <form tal:condition="view/can_edit | nothing"
            class="inline-text-edit"
            hx-swap="none"
            hx-trigger="save-text"
            style="display:none;"
            tal:attributes="hx-post string:${context/absolute_url}/@@savetext">
          <textarea name="newText"
                    class="pat-tinymce"
                    rows="20"
                    tal:attributes="id string:editableText_${context/UID};
                                    data-pat-tinymce view/tinymce_options"
                    tal:content="view/get_text"></textarea>
          <input name="_authenticator" type="hidden"
                 tal:attributes="value context/@@authenticator/token">
      </form>
    </div>
</div>
</metal:content-core>
</metal:main>

</body>
</html>
