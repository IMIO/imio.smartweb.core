<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:browser="http://namespaces.zope.org/browser"
    xmlns:plone="http://namespaces.plone.org/plone">

  <!-- Patching a taxonomy reindexes the objects whose labels change -->
  <plone:service
      method="PATCH"
      factory=".taxonomy.SmartwebTaxonomyPatch"
      for="plone.base.interfaces.IPloneSiteRoot"
      permission="cmf.ManagePortal"
      name="@taxonomy"
      layer="imio.smartweb.core.interfaces.IImioSmartwebCoreLayer"
      />

  <!-- Messages (collective.messagesviewlet) -->
  <plone:service
      method="GET"
      accept="application/json"
      factory=".messages.MessagesGet"
      for="Products.CMFPlone.interfaces.IPloneSiteRoot"
      permission="zope2.View"
      name="@messages"
      />

  <!-- Editorial content of a page, for the Prefect ETL.
       Footer and HeroBanner are not eligible: they are parts of other pages -->
  <plone:service
      method="GET"
      accept="application/json"
      factory=".prefect.PrefectGet"
      for="imio.smartweb.core.contents.IPage"
      permission="zope2.View"
      name="@prefect"
      />

  <plone:service
      method="GET"
      accept="application/json"
      factory=".prefect.PrefectGet"
      for="imio.smartweb.core.contents.IPortalPage"
      permission="zope2.View"
      name="@prefect"
      />

  <plone:service
      method="GET"
      accept="application/json"
      factory=".prefect.PrefectGet"
      for="imio.smartweb.core.contents.IProcedure"
      permission="zope2.View"
      name="@prefect"
      />

  <!-- Directory  -->
  <plone:service
      method="GET"
      accept="application/json"
      factory=".authentic_sources.DirectoryRequestForwarder"
      for="*"
      permission="zope2.View"
      name="@directory_request_forwarder"
      />

  <plone:service
      method="POST"
      accept="application/json"
      factory=".authentic_sources.DirectoryRequestForwarder"
      for="*"
      permission="zope2.View"
      name="@directory_request_forwarder"
      />

  <plone:service
      method="PATCH"
      accept="application/json"
      factory=".authentic_sources.DirectoryRequestForwarder"
      for="*"
      permission="zope2.View"
      name="@directory_request_forwarder"
      />

  <plone:service
      method="DELETE"
      accept="application/json"
      factory=".authentic_sources.DirectoryRequestForwarder"
      for="*"
      permission="zope2.View"
      name="@directory_request_forwarder"
      />


  <!-- Events  -->
  <plone:service
      method="GET"
      accept="application/json"
      factory=".authentic_sources.EventsRequestForwarder"
      for="*"
      permission="zope2.View"
      name="@events_request_forwarder"
      />

  <plone:service
      method="POST"
      accept="application/json"
      factory=".authentic_sources.EventsRequestForwarder"
      for="*"
      permission="zope2.View"
      name="@events_request_forwarder"
      />

  <plone:service
      method="PATCH"
      accept="application/json"
      factory=".authentic_sources.EventsRequestForwarder"
      for="*"
      permission="zope2.View"
      name="@events_request_forwarder"
      />

  <plone:service
      method="DELETE"
      accept="application/json"
      factory=".authentic_sources.EventsRequestForwarder"
      for="*"
      permission="zope2.View"
      name="@events_request_forwarder"
      />


  <!-- News  -->
  <plone:service
      method="GET"
      accept="application/json"
      factory=".authentic_sources.NewsRequestForwarder"
      for="*"
      permission="zope2.View"
      name="@news_request_forwarder"
      />

  <plone:service
      method="POST"
      accept="application/json"
      factory=".authentic_sources.NewsRequestForwarder"
      for="*"
      permission="zope2.View"
      name="@news_request_forwarder"
      />

  <plone:service
      method="PATCH"
      accept="application/json"
      factory=".authentic_sources.NewsRequestForwarder"
      for="*"
      permission="zope2.View"
      name="@news_request_forwarder"
      />

  <plone:service
      method="DELETE"
      accept="application/json"
      factory=".authentic_sources.NewsRequestForwarder"
      for="*"
      permission="zope2.View"
      name="@news_request_forwarder"
      />

</configure>
