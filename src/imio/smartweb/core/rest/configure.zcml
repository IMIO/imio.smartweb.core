<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:browser="http://namespaces.zope.org/browser"
    xmlns:plone="http://namespaces.plone.org/plone">

  <!-- Messages (collective.messagesviewlet) -->
  <plone:service
      method="GET"
      accept="application/json"
      factory=".messages.MessagesGet"
      for="Products.CMFPlone.interfaces.IPloneSiteRoot"
      permission="zope2.View"
      name="@messages"
      />

  <!-- E-guichet API settings, for authentic sources (role check in the service) -->
  <plone:service
      method="GET"
      accept="application/json"
      factory=".eguichet.EguichetApiSettingsGet"
      for="Products.CMFPlone.interfaces.IPloneSiteRoot"
      permission="zope2.View"
      name="@eguichet-api-settings"
      />

  <!-- Directory  -->
  <plone:service
      method="GET"
      accept="application/json"
      factory=".authentic_sources.DirectoryRequestForwarder"
      for="*"
      permission="zope2.View"
      name="@directory_request_forwarder"
      />

  <plone:service
      method="POST"
      accept="application/json"
      factory=".authentic_sources.DirectoryRequestForwarder"
      for="*"
      permission="zope2.View"
      name="@directory_request_forwarder"
      />

  <plone:service
      method="PATCH"
      accept="application/json"
      factory=".authentic_sources.DirectoryRequestForwarder"
      for="*"
      permission="zope2.View"
      name="@directory_request_forwarder"
      />

  <plone:service
      method="DELETE"
      accept="application/json"
      factory=".authentic_sources.DirectoryRequestForwarder"
      for="*"
      permission="zope2.View"
      name="@directory_request_forwarder"
      />


  <!-- Events  -->
  <plone:service
      method="GET"
      accept="application/json"
      factory=".authentic_sources.EventsRequestForwarder"
      for="*"
      permission="zope2.View"
      name="@events_request_forwarder"
      />

  <plone:service
      method="POST"
      accept="application/json"
      factory=".authentic_sources.EventsRequestForwarder"
      for="*"
      permission="zope2.View"
      name="@events_request_forwarder"
      />

  <plone:service
      method="PATCH"
      accept="application/json"
      factory=".authentic_sources.EventsRequestForwarder"
      for="*"
      permission="zope2.View"
      name="@events_request_forwarder"
      />

  <plone:service
      method="DELETE"
      accept="application/json"
      factory=".authentic_sources.EventsRequestForwarder"
      for="*"
      permission="zope2.View"
      name="@events_request_forwarder"
      />


  <!-- News  -->
  <plone:service
      method="GET"
      accept="application/json"
      factory=".authentic_sources.NewsRequestForwarder"
      for="*"
      permission="zope2.View"
      name="@news_request_forwarder"
      />

  <plone:service
      method="POST"
      accept="application/json"
      factory=".authentic_sources.NewsRequestForwarder"
      for="*"
      permission="zope2.View"
      name="@news_request_forwarder"
      />

  <plone:service
      method="PATCH"
      accept="application/json"
      factory=".authentic_sources.NewsRequestForwarder"
      for="*"
      permission="zope2.View"
      name="@news_request_forwarder"
      />

  <plone:service
      method="DELETE"
      accept="application/json"
      factory=".authentic_sources.NewsRequestForwarder"
      for="*"
      permission="zope2.View"
      name="@news_request_forwarder"
      />

</configure>
